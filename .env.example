# .env.example — copy to .env (gitignored) and fill in your real values.
# Used by ci/run-test.sh on the CI Mac host. Never commit .env.

# --- the CI Mac host (only needed if you trigger run-test.sh over ssh) ---
CI_USER=youruser
CI_HOST=10.0.0.44
CI_REPO=/Users/youruser/Projects/03.systems/bootstrap

# --- Linux ARM template VM ---
LINUX_VMX=/Users/youruser/Library/Application Support/VMware Fusion/Virtual Machines/ubuntu-arm.vmx
LINUX_HOST=10.0.0.50
LINUX_USER=ci

# --- Windows 11 ARM template VM ---
WIN_VMX=/Users/youruser/Library/Application Support/VMware Fusion/Virtual Machines/win11-arm.vmx
WIN_HOST=10.0.0.51
WIN_USER=ci

# --- model connectivity test (use a cheap throwaway key) ---
TEST_PROVIDER=deepseek            # bailian | deepseek | openrouter
TEST_API_KEY=sk-replace-me

# --- cohort smoke (dsh-desktop/cohort/ci/smoke.sh) ---
# A real Bailian key shared by a training cohort, used only for the minimal
# chat call in the cohort smoke test. Never commit the real value.
COHORT_CI_KEY=sk-replace-me
COHORT_CI_MODEL=deepseek-v4-flash-0731  # the cohort main model (a cheap flash); or any model your key allows
COHORT_CI_VERIFY_MAIN_MODEL=0        # set 1 to also call deepseek-v4-flash-0731
